# Example environment variables for data extraction framework
# Copy this file to .env and fill in your values

# Facebook API credentials
FACEBOOK_ACCESS_TOKEN=your_access_token_here
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_ACCOUNT_ID=your_account_id_here

# LimeSurvey SSH credentials
LS_SSH_KEY_PATH=~/.ssh/id_rsa

# WordPress API credentials
WP_SITE_URL=https://your-wordpress-site.com
WP_SITES_API_URL=https://pipeline.bionews.com/query/sites
WP_API_USERNAME=your_username_here
WP_API_PASSWORD=your_password_here
WP_API_KEY=your_api_key_here

# Screaming Frog SEO Spider license
SCREAMING_FROG_LICENSE_KEY=your_license_key_here

# Google Cloud credentials
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
GCS_BUCKET=your_gcs_bucket_name_here

# Email/SMTP credentials for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=pipeline@company.com

# Google Maps Geocoding API (for street-level doctor address geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database connection strings (if needed)
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/database
SNOWFLAKE_CONNECTION_STRING=snowflake://user:password@account/database/schema?warehouse=warehouse&role=role
















