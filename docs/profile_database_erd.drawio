        <!-- RELATIONSHIP LEGEND -->
        <!-- ================================================================ -->
        <mxCell id="legend" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;hr size='1'/&gt;&lt;font style='font-size:10px'&gt;profile_core (1) ─── (1) profile_patient&lt;br/&gt;&amp;nbsp;&amp;nbsp;Filter: account_type = 'patient'&lt;br/&gt;&lt;br/&gt;profile_core (1) ─── (1) profile_caregiver&lt;br/&gt;&amp;nbsp;&amp;nbsp;Filter: account_type = 'caregiver'&lt;br/&gt;&lt;br/&gt;profile_core (1) ─── (1) profile_hcp&lt;br/&gt;&amp;nbsp;&amp;nbsp;Filter: account_type = 'hcp'&lt;br/&gt;&lt;br/&gt;profile_core (1) ─── (1) profile_family_or_friend&lt;br/&gt;&amp;nbsp;&amp;nbsp;Filter: account_type = 'family_or_friend'&lt;br/&gt;&lt;br/&gt;profile_core (1) ─── (1) profile_other&lt;br/&gt;&amp;nbsp;&amp;nbsp;Filter: account_type = 'other'&lt;br/&gt;&lt;br/&gt;profile_core (1) ─── (1) profile_engagement&lt;br/&gt;profile_core (1) ─── (1) profile_forum_settings&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_identifiers&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_newsletter_preferences&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_consent&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_survey_data&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_events&lt;br/&gt;profile_core (1) ──&amp;lt; (N) site_events&lt;br/&gt;profile_core (1) ──&amp;lt; (N) profile_zero_party&lt;br/&gt;&lt;br/&gt;subtypes_dict (N) ──&amp;gt; (1) conditions_dict&lt;br/&gt;&amp;nbsp;&amp;nbsp;FK: subtypes_dict.condition_key&lt;br/&gt;&lt;br/&gt;profile_identifiers ──&amp;gt; identity_hub_data.bn_id_xref&lt;br/&gt;&amp;nbsp;&amp;nbsp;Materialized copy from identity hub&lt;br/&gt;&lt;br/&gt;dictionary_meta — standalone (no FK)&lt;br/&gt;ref_* tables — standalone enums (no FK)&lt;/font&gt;" style="text;html=1;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="50" width="370" height="580" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- TABLE DESCRIPTIONS -->
        <!-- ================================================================ -->
        <mxCell id="descriptions" value="&lt;b&gt;Table Descriptions&lt;/b&gt;&lt;hr size='1'/&gt;&lt;font style='font-size:9px'&gt;&lt;b&gt;profile_core&lt;/b&gt; — Central profile. Identity, persona, demographics, consent, name. One row per person.&lt;br/&gt;&lt;b&gt;profile_patient&lt;/b&gt; — Patient sub-profile. Condition subtype, diagnosis, symptoms, treatments.&lt;br/&gt;&lt;b&gt;profile_caregiver&lt;/b&gt; — Caregiver sub-profile. Condition supported, relationship, focus areas.&lt;br/&gt;&lt;b&gt;profile_hcp&lt;/b&gt; — HCP sub-profile. NPI data, specialty, practice location, credentials.&lt;br/&gt;&lt;b&gt;profile_family_or_friend&lt;/b&gt; — Family/friend sub-profile. Condition following, relationship.&lt;br/&gt;&lt;b&gt;profile_other&lt;/b&gt; — Other sub-profile. Interest tags, followed conditions.&lt;br/&gt;&lt;b&gt;profile_engagement&lt;/b&gt; — Engagement summary. Email, web, forms, video, ads, engagement tier.&lt;br/&gt;&lt;b&gt;profile_identifiers&lt;/b&gt; — All identifiers per person. Materialized from identity hub.&lt;br/&gt;&lt;b&gt;site_events&lt;/b&gt; — Site analytics events from GA4/GTM. Page views, scrolls, forms.&lt;br/&gt;&lt;b&gt;profile_events&lt;/b&gt; — Lifecycle events. SSO login, profile update, consent change.&lt;br/&gt;&lt;b&gt;profile_survey_data&lt;/b&gt; — CDE-normalized survey responses from LimeSurvey.&lt;br/&gt;&lt;b&gt;profile_consent&lt;/b&gt; — Consent purposes per user. Pending OneTrust integration.&lt;br/&gt;&lt;b&gt;profile_newsletter_preferences&lt;/b&gt; — Per-user per-site newsletter subscriptions.&lt;br/&gt;&lt;b&gt;profile_forum_settings&lt;/b&gt; — BuddyBoss community preferences. SSO users only.&lt;br/&gt;&lt;b&gt;profile_zero_party&lt;/b&gt; — Quiz, poll, inline prompt responses from editorial content.&lt;br/&gt;&lt;b&gt;conditions_dict&lt;/b&gt; — Curated condition vocabulary (MeSH, ICD-10, aliases).&lt;br/&gt;&lt;b&gt;symptoms_dict&lt;/b&gt; — Curated symptom vocabulary (MeSH + HPO, severity scales).&lt;br/&gt;&lt;b&gt;treatments_dict&lt;/b&gt; — Curated treatment vocabulary (RxNorm, treatment class).&lt;br/&gt;&lt;b&gt;subtypes_dict&lt;/b&gt; — Condition subtype vocabulary (SNOMED, business codes).&lt;br/&gt;&lt;b&gt;dictionary_meta&lt;/b&gt; — Dictionary provenance and versioning.&lt;br/&gt;&lt;b&gt;ref_*&lt;/b&gt; (16 tables) — Enum/picklist tables for constrained field validation.&lt;/font&gt;" style="text;html=1;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="660" width="370" height="540" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
